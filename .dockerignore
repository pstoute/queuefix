# Deny the host checkout by default. Only files required to build and run the
# application are admitted below; local credentials and runtime state never
# enter the build context.
**

!.dockerignore
!.pnpmrc.json
!Dockerfile
!artisan
!composer.json
!composer.lock
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!postcss.config.js
!tailwind.config.js
!tsconfig.json
!vite.config.js

!app/
!app/**
!bootstrap/
bootstrap/**
!bootstrap/app.php
!bootstrap/providers.php
!config/
!config/**
!database/
database/**
!database/.gitignore
!database/factories/
!database/factories/**
!database/migrations/
!database/migrations/**
!database/seeders/
!database/seeders/**
!public/
!public/**
public/build/**
public/hot
public/storage
!resources/
!resources/**
!routes/
!routes/**

# These rules intentionally come last. Source trees are open to normal project
# files above, but secret, credential, database, backup, and dependency shapes
# remain excluded at every nesting depth.
**/.env
**/.env.*
**/.envrc
**/*.env
**/*.env.*
**/.git
**/.git/**
**/.netrc
**/.npmrc
**/.yarnrc*
**/auth.json
**/*credential*
**/*secret*
**/service-account*.json
**/*firebase-adminsdk*
**/id_rsa*
**/id_ed25519*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.p8
**/*.ppk
**/*.jks
**/*.keystore
**/*.sqlite*
**/*.db*
**/*.sql*
**/*.dump*
**/*.backup*
**/*.bak*
**/*.tfstate*
**/*.log
**/node_modules
**/node_modules/**
**/vendor
**/vendor/**

# Docker matches patterns case-sensitively on Linux. Mirror critical secret
# shapes with character classes so case variants cannot bypass the rules.
**/.[eE][nN][vV]
**/.[eE][nN][vV].*
**/.[eE][nN][vV][rR][cC]
**/*.[eE][nN][vV]
**/*.[eE][nN][vV].*
**/[aA][uU][tT][hH].[jJ][sS][oO][nN]
**/[sS][eE][rR][vV][iI][cC][eE]-[aA][cC][cC][oO][uU][nN][tT]*
**/[iI][dD]_[rR][sS][aA]*
**/[iI][dD]_[eE][dD]25519*
**/*[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL]*
**/*[sS][eE][cC][rR][eE][tT]*
**/*[fF][iI][rR][eE][bB][aA][sS][eE]-[aA][dD][mM][iI][nN][sS][dD][kK]*
**/*[_-][kK][eE][yY]*
**/*.[kK][eE][yY]
**/*.[pP][eE][mM]
**/*.[pP]12
**/*.[pP][fF][xX]
**/*.[pP]8
**/*.[pP][pP][kK]
**/*.[jJ][kK][sS]
**/*.[kK][eE][yY][sS][tT][oO][rR][eE]
**/*.[sS][qQ][lL][iI][tT][eE]*
**/*.[dD][bB]*
**/*.[sS][qQ][lL]*
**/*.[dD][uU][mM][pP]*
**/*.[bB][aA][cC][kK][uU][pP]*
**/*.[bB][aA][kK]*
**/*.[tT][fF][sS][tT][aA][tT][eE]*
