APP_NAME="QueueFix"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — PostgreSQL 16+ (default)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=queuefix
DB_USERNAME=queuefix
DB_PASSWORD=secret

# Database — MySQL 8.0+ (alternative, uncomment and comment out the block above)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=queuefix
# DB_USERNAME=queuefix
# DB_PASSWORD=secret

# Database — SQLite (lightweight, good for demos)
# DB_CONNECTION=sqlite
# DB_SQLITE_DATABASE= (leave empty to use database/database.sqlite)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
ATTACHMENT_DISK=private
ATTACHMENT_OPERATION_LOCK_STORE=file
ATTACHMENT_OPERATION_LOCK_SECONDS=3600
ATTACHMENT_OPERATION_LOCK_WAIT_SECONDS=10
ATTACHMENT_MAX_FILES=10
ATTACHMENT_MAX_FILE_BYTES=10485760
ATTACHMENT_MAX_MESSAGE_BYTES=26214400
INBOUND_EMAIL_MAX_BODY_BYTES=2097152
INBOUND_EMAIL_MAX_PROVIDER_MESSAGE_BYTES=41943040
INBOUND_EMAIL_MAX_MIME_DEPTH=32
INBOUND_EMAIL_MAX_MIME_PARTS=1000
ATTACHMENT_MAX_MAILBOX_BYTES=5368709120
ATTACHMENT_MAX_INSTALLATION_BYTES=26843545600
ATTACHMENT_SCANNING_REQUIRED=true
QUEUE_CONNECTION=database

CACHE_STORE=database
RATE_LIMITER_STORE=database

# Require at least one trusted proxy when the application is deployed behind one.
# Docker Compose overrides these defaults with its exact, fixed bridge gateway.
TRUSTED_PROXY_REQUIRED=false
# Comma-separated exact IPs or CIDRs for reverse proxies you operate.
# Leave empty for direct non-Compose access; never use a wildcard.
TRUSTED_PROXIES=

# Keep these values on the same private subnet. Override both if it conflicts
# with another Docker network on the host.
QUEUEFIX_NETWORK_SUBNET=172.30.255.0/28
QUEUEFIX_NETWORK_GATEWAY=172.30.255.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — Default uses Mailpit for local dev
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth (for agent login via Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Microsoft OAuth (for agent login via Microsoft)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"
MICROSOFT_TENANT_ID=common

# Google Gmail API (for mailbox connections)
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=

# Microsoft Graph API (for mailbox connections)
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_TENANT_ID=

# Inbound polling and recoverable pending-work leases
INBOUND_EMAIL_POLL_BATCH_SIZE=50
INBOUND_EMAIL_CLAIM_LEASE_SECONDS=900
INBOUND_EMAIL_RETRY_BASE_SECONDS=300
INBOUND_EMAIL_RETRY_MAX_SECONDS=3600
INBOUND_EMAIL_MAX_FAILURE_COUNT=5

# Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Update checks (public GitHub release metadata only; never installs code)
QUEUEFIX_VERSION=v1.1.1
QUEUEFIX_UPDATE_REPOSITORY=pstoute/queuefix
QUEUEFIX_UPDATE_CACHE_HOURS=12
QUEUEFIX_UPDATE_TIMEOUT_SECONDS=3

# Demo Mode (set to true only for disposable demos)
QUEUEFIX_DEMO_MODE=false
# QUEUEFIX_DEMO_RESET_INTERVAL_MINUTES=60
# QUEUEFIX_DEMO_GITHUB_URL=https://github.com/yourusername/queuefix

VITE_APP_NAME="${APP_NAME}"
